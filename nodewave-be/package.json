{
  "name": "nodewave-be",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "bun prisma/seed.ts",
    "postinstall": "prisma generate",
    "deploy:release": "prisma migrate deploy && bun prisma/seed.ts"
  },
  "dependencies": {
    "@nodewave/prisma-ezfilter": "^0.2.1",
    "@prisma/adapter-pg": "^6.16.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.7",
    "prisma": "^6.16.0",
    "typescript": "^5.6.0"
  }
}
