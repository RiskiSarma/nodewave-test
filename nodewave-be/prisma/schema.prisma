generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PM
  INTERNAL
  CLIENT
}

enum Department {
  PRODUCT
  UIUX
  FRONTEND
  BACKEND
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  avatarUrl    String?
  passwordHash String
  role         Role
  department   Department?
  /// Bumped on logout -> every previously issued JWT becomes invalid.
  tokenVersion Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  memberships     ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  comments        Comment[]
  attachments     Attachment[]
  auditLogs       AuditLog[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members ProjectMember[]
  tasks   Task[]
}

/// Membership doubles as the tenant boundary: INTERNAL users see only projects
/// they are a member of, CLIENT users are members of exactly their own project.
model ProjectMember {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  title         String
  description   String     @default("")
  status        TaskStatus @default(TODO)
  /// Discipline that owns / executes the task.
  department    Department
  assigneeId    String?
  clientVisible Boolean    @default(false)
  dueDate       DateTime?
  /// Optimistic-lock counter. Every successful write increments it.
  version       Int        @default(1)
  createdById   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  project      Project          @relation(fields: [projectId], references: [id])
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy    User             @relation("TaskCreator", fields: [createdById], references: [id])
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("PrerequisiteTask")
  comments     Comment[]
  attachments  Attachment[]

  @@index([projectId, deletedAt])
  @@index([assigneeId])
}

/// `task` cannot start before `dependsOn` is DONE.
model TaskDependency {
  id          String    @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  task      Task @relation("DependentTask", fields: [taskId], references: [id])
  dependsOn Task @relation("PrerequisiteTask", fields: [dependsOnId], references: [id])

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model Attachment {
  id          String    @id @default(cuid())
  taskId      String
  uploaderId  String
  fileName    String
  mimeType    String
  size        Int
  storagePath String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  task     Task @relation(fields: [taskId], references: [id])
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([taskId])
}

/// Append-only. UPDATE / DELETE / TRUNCATE are rejected by DB triggers
/// (see prisma/migrations/*_audit_immutable).
model AuditLog {
  id            String   @id @default(cuid())
  projectId     String
  taskId        String?
  entity        String
  entityId      String
  action        String
  userId        String
  changedColumn String
  oldValue      String?
  newValue      String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}
